public class Main {

    static class Student {
        String name;
        int[] quizzes;

        Student(String name, int[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }

        double getAverage() {
            int total = 0;

            for (int i = 0; i < quizzes.length; i++) {
                total = total + quizzes[i];
            }

            return (double) total / quizzes.length;
        }
    }

    static int findRank(Student[] students, String name) {

        for (int i = 0; i < students.length; i++) {

            if (students[i].name.equals(name)) {
                return i + 1;
            }
        }

        return -1;
    }

    static void sortStudents(Student[] students) {

        for (int i = 0; i < students.length - 1; i++) {

            for (int j = i + 1; j < students.length; j++) {

                if (students[j].getAverage() > students[i].getAverage()) {

                    Student temp = students[i];
                    students[i] = students[j];
                    students[j] = temp;
                }
            }
        }
    }

    public static void main(String[] args) {

        String[][] rawData = {
            {"Juan", "90", "85", "88", "92"},
            {"Maria", "95", "90", "93", "92"},
            {"Pedro", "80", "85", "82", "83"},
            {"Ana", "95", "90", "93", "92"},
            {"Mark", "75", "80", "78", "82"}
        };

        Student[] students = new Student[rawData.length];

        for (int i = 0; i < rawData.length; i++) {

            int[] quizzes = new int[4];

            for (int j = 0; j < 4; j++) {
                quizzes[j] = Integer.parseInt(rawData[i][j + 1]);
            }

            students[i] = new Student(rawData[i][0], quizzes);
        }

        sortStudents(students);

        System.out.println("CLASS LEADERBOARD");
        System.out.println("----------------------------");

        for (int i = 0; i < students.length; i++) {

            int rank;

            if (i > 0 &&
                students[i].getAverage() == students[i - 1].getAverage()) {

                rank = i;
            } else {
                rank = i + 1;
            }

            System.out.printf("%d. %s - Average: %.2f%n",
                    rank,
                    students[i].name,
                    students[i].getAverage());
        }

        String searchName = "Juan";

        int rank = findRank(students, searchName);

        System.out.println();
        System.out.println("Search: " + searchName);

        if (rank != -1) {
            System.out.println(searchName + "'s rank is: " + rank);
        } else {
            System.out.println("Student not found.");
        }
    }
}

public class Main {
    public static void main(String[] args) {

        int a = 5 + 3 * 2;
        System.out.println("Expression 1: " + a);

        boolean b = 10 > 5 && 4 < 2;
        System.out.println("Expression 2: " + b);

        int x = 5;
        int c = x++ + 3;
        System.out.println("Expression 3: " + c);
        System.out.println("Value of x: " + x);

    }
}

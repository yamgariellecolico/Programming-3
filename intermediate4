import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        int number;
        int total = 0;

        System.out.println("Enter numbers (-1 to stop):");

        number = input.nextInt();

        while (number != -1) {
            total = total + number;
            number = input.nextInt();
        }

        System.out.println("Final Total: " + total);
    }
}
